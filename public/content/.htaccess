<IfModule mod_rewrite.c>
	<IfModule mod_negotiation.c>
		Options -Indexes -ExecCGI
	</IfModule>	
</IfModule>

<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

<FilesMatch "(?i)\.(php|phtml|php3|php4|php5|php7|php8|phar|phps|inc|pl|py|cgi|sh|bash|htaccess|htpasswd)$">
    <IfModule !mod_authz_core.c>
        Order Deny,Allow
        Deny from all
    </IfModule>
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</FilesMatch>